# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by admin/webhook operations. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Groq (server-only) ──────────────────────────────────────────────────────
# Create a key at https://console.groq.com/keys
# Models in use: openai/gpt-oss-120b (primary), openai/gpt-oss-20b (scoring)
GROQ_API_KEY=your-groq-key

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys (test mode first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Create a recurring monthly plan of ₹299 (29900 paise) in INR, then paste its id:
RAZORPAY_PLAN_ID=plan_xxxxxxxx
# Dashboard → Settings → Webhooks: point at the razorpay-webhook Edge Function
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Prospect discovery APIs (server-only, both free) ───────────────────────
# Reddit: create a "web app" script at https://www.reddit.com/prefs/apps
# (script-type app; free tier 100 QPM with OAuth — plenty for discovery)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
# YouTube: enable YouTube Data API v3 in Google Cloud, create an API key
# (free 10,000 quota units/day; each search costs 100 units)
YOUTUBE_API_KEY=your-youtube-api-key

# ── Weekly check-ins (the retention job) ───────────────────────────────────
# Shared secret for POST /api/cron/checkins. Vercel Cron sends it automatically
# as `Authorization: Bearer $CRON_SECRET` when this is set on the project; the
# `weekly-checkins` Supabase Edge Function passes the same secret through.
# Without it the endpoint returns 503 rather than running unauthenticated.
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── Email (optional — in-app check-ins work without it) ────────────────────
# Resend API key: https://resend.com/api-keys. When unset, the check-in job
# still writes the in-app notification and simply skips the email.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Markoby <hello@your-domain.com>"

# ── Absolute URLs used in emails and metadata ──────────────────────────────
NEXT_PUBLIC_SITE_URL=https://markoby.vercel.app

# International plan: $5/month USD Razorpay subscription plan id
# (create a second plan in the Razorpay dashboard with currency=USD, amount=500).
# Optional: without it, international users fall back to the INR flow.
RAZORPAY_USD_PLAN_ID=

# PayPal (international USD subscriptions) — sandbox first, then live.
# PAYPAL_WEBHOOK_ID comes from the PayPal developer dashboard webhook setup.
# PAYPAL_PLAN_ID is the id of the $5/month USD recurring plan (recommended:
# create it in the PayPal dashboard and reference it here, rather than
# letting the app auto-create it).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
